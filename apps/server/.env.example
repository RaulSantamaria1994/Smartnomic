# Copia este archivo como .env para desarrollo (`pnpm dev` lo carga si existe).
# PostgreSQL de docker-compose.yml. Sin DATABASE_URL, el servidor solo responde /health.
DATABASE_URL=postgresql://smartnomic:smartnomic@localhost:5432/smartnomic
# Secreto para firmar las sesiones. Obligatorio en producción: `openssl rand -hex 32`.
BETTER_AUTH_SECRET=
# URL pública del servidor.
BETTER_AUTH_URL=http://localhost:3000
# Orígenes de la web de Expo en desarrollo, separados por comas.
CORS_ORIGINS=http://localhost:8081
